# Server Environment Configuration
# Copy this file to .env inside /server (or place at project root)

# Google Gemini API key (Server-only secret)
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# GitHub Integration
# GitHub personal access token (optional, for higher rate limits and private stats)
GITHUB_TOKEN=
# GitHub username to display (defaults to tarunx47)
GITHUB_USERNAME=tarunx47

# Server Configuration
PORT=5001
# Allowed browser origins for CORS (comma-separated when needed). Vercel also
# automatically permits its deployment URL through VERCEL_URL.
CORS_ORIGIN=http://localhost:5173
# Set to true if running behind a reverse proxy (e.g. Render, Railway, Nginx)
isTrustProxy=false

# Rate Limiting for /api/chat
RATE_LIMIT_MAX_REQUESTS=8
RATE_LIMIT_WINDOW_MS=60000
